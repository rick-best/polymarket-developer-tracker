[Unit]
Description=Polymarket Developer Tracker daily email report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/polymarket-developer-tracker
EnvironmentFile=/etc/polymarket-developer-tracker.env
ExecStart=/usr/bin/npm run email:send
StandardOutput=append:/var/log/polymarket-daily-email.log
StandardError=append:/var/log/polymarket-daily-email.err
